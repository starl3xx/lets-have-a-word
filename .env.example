# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lets_have_a_word

# Farcaster / Neynar
# Get your API key from https://dev.neynar.com/
NEYNAR_API_KEY=your_neynar_api_key_here

# User Score Allowlist (Milestone 5.3)
# Comma-separated FIDs that bypass the Neynar score check
# Use this for trusted users with low scores (e.g., new accounts, friends)
# Example: USER_SCORE_ALLOWLIST=12345,67890,11111
USER_SCORE_ALLOWLIST=

# Account-Age Gating (post-Round-28 sybil defense)
# Blocks guessing from freshly-minted Farcaster accounts. The quality score
# gate rubber-stamps normal-looking fresh FIDs; age is the orthogonal signal.
# Source of truth: Farcaster Hub onChainEvents API (Register event timestamp).
ACCOUNT_AGE_GATING_ENABLED=false     # Set to "true" to enforce
ACCOUNT_AGE_MIN_DAYS=14               # Minimum FID age in days
ACCOUNT_AGE_ALLOWLIST=                # Comma-separated FIDs that bypass the check
# Optional — defaults to https://hub-api.neynar.com (uses NEYNAR_API_KEY as x-api-key)
# FARCASTER_HUB_URL=https://hub-api.neynar.com

# Wallet-History Gating (post-Round-29 sybil defense)
# Blocks accounts whose connected wallet has minimal Base onchain activity.
# The Round 28/29 farm's wallets clustered tightly at 8–12 outgoing txs;
# legit players sit at hundreds-to-thousands. Two-orders-of-magnitude gap.
# Uses BASE_RPC_URL for eth_getTransactionCount; falls back to public RPC.
# NOTE: tx_count is fundamentally meaningless for Coinbase Smart Wallet
# users (their activity flows through ERC-4337 EntryPoint, not the wallet's
# own nonce). The wallet-cluster gate below is the more reliable signal.
WALLET_HISTORY_GATING_ENABLED=false   # Set to "true" to enforce
WALLET_HISTORY_MIN_TXS=20             # Minimum outgoing tx count on Base
WALLET_HISTORY_ALLOWLIST=             # Comma-separated FIDs that bypass

# Wallet-Cluster Gating (post-Round-29 sybil defense, third layer)
# Catches the specific R28/R29 fingerprint: `.base.eth` wallets co-deployed
# in tight time windows. Per the 168-user empirical sample:
# - Real LHAW players: wallet first-tx dates spread across months (max
#   natural cluster size: 2)
# - R28/R29 bots: 22 wallets in a single 3-hour window on 2026-03-15
# Compound trigger: low score + cluster_size >= MIN_COHORT (any one missing →
# user passes). Scope is ALL users by default (June 2026): the farm evaded the
# original `.base.eth`-only scope by winning with placeholder usernames
# (Rounds 31/32). Pure Farcaster/Warpcast users with no Base activity still pass
# (no resolvable first-tx → fail open).
# Uses Blockscout (https://base.blockscout.com) for wallet first-tx lookup.
WALLET_CLUSTER_GATING_ENABLED=false      # Set to "true" to enforce
WALLET_CLUSTER_MIN_COHORT=5              # Cluster size that triggers a block
WALLET_CLUSTER_WINDOW_HOURS=1            # ± hours around wallet first-tx
WALLET_CLUSTER_SCORE_MAX=0.70            # Bypass for users with score >= this
WALLET_CLUSTER_ALLOWLIST=                # Comma-separated FIDs that bypass
WALLET_CLUSTER_REQUIRE_BASE_ETH=false    # "true" → legacy narrow scope (only .base.eth usernames)
# A Coinbase onchain "Verified Account" attestation (EAS on Base) exempts a
# wallet from the cluster heuristic. On unless explicitly set to "false": it
# only ever makes the gate more permissive, and it is what makes the gate safe
# to switch on, since co-mint clustering is circumstantial and catches players
# onboarded in a launch wave alongside the farm. Set "false" if verified
# accounts ever start appearing in the farm's own wallets.
WALLET_CLUSTER_ATTESTATION_BYPASS=true
# Two behavioural exemptions, both on unless set to "false". They exist because
# the first production dry run showed the attestation bypass clearing only 6 of
# 244 blocked candidates — real players mostly do not hold Coinbase
# verifications, so it did not make the gate safe on its own.
#
# PURCHASE: no bot has ever bought a guess pack across 33 rounds, and that is
# structural — the farm's model is many free accounts, so it never needs paid
# guesses. Publishing this as a bypass does invite buying one pack per account
# to unlock it, but the cost scales with account count, which is exactly the
# axis the farm depends on, and a farm that pays is funding the pool it wants
# to win.
#
# SHARE: weaker, since a cast can be automated — but far more common, because
# sharing for an extra guess is ordinary play. The bonus is only granted after
# a real public cast is verified, so faking it at scale means thousands of
# visible casts, which is what got the last swarm noticed.
WALLET_CLUSTER_PURCHASE_BYPASS=true
WALLET_CLUSTER_SHARE_BYPASS=true
# Optional override; defaults to https://base.blockscout.com
# BASE_BLOCKSCOUT_URL=https://base.blockscout.com

# Admin API secret (REQUIRED to protect /api/admin/*)
#
# Until this is set, the ~80 admin endpoints are protected only by a caller-
# supplied FID — and the admin FIDs are hardcoded in
# components/admin/AdminAuthWrapper.tsx, which ships inside the browser bundle.
# So `?devFid=6500` is published information, not a guess. Three endpoints had
# no check at all.
#
# That reaches endpoints which return a round's decrypted answer, send the
# contract's whole $WORD balance to a caller-supplied address, and pay ETH out
# of the operator wallet.
#
# Set this and middleware.ts requires it on every /api/admin/* request. The
# dashboard prompts for it once and stores it in a session cookie, so the
# existing UI keeps working unchanged. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Sign In With Farcaster (admin dashboard)
#
# Neynar retired Sign In With Neynar on 2026-08-14 — existing connections keep
# working but no new ones are issued, so the old flow would strand anyone
# signing in on a new browser. The dashboard now uses SIWF via
# @farcaster/auth-kit, verified server-side by /api/auth/verify.
#
# NEXT_PUBLIC_SIWF_DOMAIN must match on both sides or every signature is
# rejected with a confusing "invalid" rather than a mismatch error.
NEXT_PUBLIC_SIWF_DOMAIN=letshaveaword.fun
#
# Verifying a SIWF signature resolves FID ownership on Optimism. With no RPC
# configured, @farcaster/auth-client falls back to the public endpoint and logs
# "Do not use this in production" — a rate-limited RPC makes admin sign-in fail
# intermittently, which looks like a wrong key rather than an outage.
OPTIMISM_RPC_URL=
NEXT_PUBLIC_OPTIMISM_RPC_URL=

# Farcaster Webhook Secret (OG Hunter Campaign)
# Shared secret for verifying webhook requests from Farcaster
# Configure this same secret in the Farcaster Developer Console webhook settings
# Generate with: openssl rand -hex 32
# REQUIRED in production - webhook calls will be rejected without it
FARCASTER_WEBHOOK_SECRET=

# ============================================================
# OG Hunter Prelaunch Campaign
# ============================================================
# Set to "1" to enable prelaunch mode (routes users to /splash)
# Set to "0" or remove to disable (normal game mode)
# When enabled:
#   - All routes redirect to /splash (except /api, /admin, /.well-known)
#   - OG Hunter badge campaign is active
#   - Users can earn badge by adding app + sharing cast
NEXT_PUBLIC_PRELAUNCH_MODE=1

# Farcaster Announcer Bot (Milestone 5.1)
# Automated announcements from @letshaveaword (FID 1477413)
# CRITICAL: Bot is COMPLETELY DISABLED when NODE_ENV !== "production"
NEYNAR_SIGNER_UUID=75a966ee-fcd5-4c04-a29f-a5d8cc646902
ANNOUNCER_FID=1477413
ANNOUNCER_ENABLED=false  # Set to "true" to enable in production
ANNOUNCER_DEBUG_LOGS=false  # Set to "true" for verbose announcer logging

# ============================================================
# Twitter/X Cross-posting (@letshaveaword_)
# ============================================================
# Cross-posts announcements to Twitter/X alongside Farcaster
# CRITICAL: Bot is COMPLETELY DISABLED when NODE_ENV !== "production"
#
# Preferred transport: Typefully (https://typefully.com, Settings → API).
# Direct X API access died silently in March 2026; the TWITTER_* credentials
# below remain only as the fallback transport when no Typefully key is set.
#
# TYPEFULLY_API_KEY=your_typefully_api_key    # Needs WRITE + PUBLISH permissions
# TYPEFULLY_SOCIAL_SET_ID=326839              # LHAW social set (this is the default)
#
# Legacy fallback — https://developer.twitter.com/en/portal/dashboard
# App must have "Read and Write" permissions
#
# TWITTER_API_KEY=your_api_key_here           # Also called "Consumer Key"
# TWITTER_API_SECRET=your_api_secret_here     # Also called "Consumer Secret"
# TWITTER_ACCESS_TOKEN=your_access_token      # OAuth 1.0a access token
# TWITTER_ACCESS_SECRET=your_access_secret    # OAuth 1.0a access token secret
TWITTER_ENABLED=false  # Set to "true" to enable in production
TWITTER_DEBUG_LOGS=false  # Set to "true" for verbose Twitter logging

# ============================================================
# Mini App Push Notifications (Milestone 11.x)
# ============================================================
# Sends push notifications to users via Neynar's Frame Notifications API
# CRITICAL: Notifications are COMPLETELY DISABLED when NODE_ENV !== "production"
#
# Get NEYNAR_APP_UUID from your Neynar developer dashboard:
# https://dev.neynar.com/ > Your App > Copy the UUID
#
# NEYNAR_APP_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTIFICATIONS_ENABLED=false  # Set to "true" to enable in production
NOTIFICATIONS_DEBUG_LOGS=false  # Set to "true" for verbose notification logging

# Neynar Auto-Like Webhook (Milestone 10.x)
# Auto-likes casts that mention @letshaveaword AND embed the game URL
# Uses NEYNAR_SIGNER_UUID above (same signer as announcer bot)
# SETUP:
# 1. Create webhook at https://dev.neynar.com/webhooks:
#    - URL: https://letshaveaword.fun/api/webhooks/neynar-mentions
#    - Event: cast.created
#    - Filter: mentioned_fids contains 1477413
# 2. Copy the webhook secret below
NEYNAR_WEBHOOK_SECRET=

# Base RPC (Milestone 4.1)
# Used for $WORD balance checking
# Defaults to https://mainnet.base.org if not set
BASE_RPC_URL=https://mainnet.base.org

# $WORD Market Cap (Milestone 5.4c, updated M14)
# Used to determine $WORD holder bonus tier thresholds
# Three tiers: <$150K, $150K-$300K, >$300K
# Defaults to 0 if not set (uses lowest tier thresholds)
# Updated by live oracle via cron job
WORD_MARKET_CAP_USD=0

# ============================================================
# $WORD Token Integration (Milestone 14)
# ============================================================
# WordManager contract address on Base
# Handles staking, bonus rewards, top-10 rewards, and burns
# Leave empty if contract not yet deployed (all features degrade gracefully)
WORD_MANAGER_ADDRESS=
# Client-side WordManager address (same value as above, needed for Wagmi staking hook)
NEXT_PUBLIC_WORD_MANAGER_ADDRESS=

# $WORD pool address for the GeckoTerminal chart link (Buy $WORD fallback,
# splash page contract link). Only needed if the pool ever moves — the address
# is hardcoded as a default in config/economy.ts.
NEXT_PUBLIC_WORD_POOL_ADDRESS=

# ETH Price (Milestone 3.2)
# Used for USD conversion in top ticker
# Defaults to 3000 if not set
ETH_USD_RATE=3000

# Environment
NODE_ENV=development

# Dev Mid-Round Test Mode (Milestone 4.5)
# Set to "true" to enable mid-round test mode in development
# This creates a dev test round with pre-populated guesses and jackpot
# NEVER enable in production!
NEXT_PUBLIC_TEST_MID_ROUND=false

# Dev Mode for Preview/Testing (Milestone 4.8)
# Master switch for dev mode - enables interactive gameplay with mock data,
# no onchain calls, and always shows tutorial overlay for testing.
# Works on both client and server.
NEXT_PUBLIC_LHAW_DEV_MODE=false

# Fixed solution word for dev mode (defaults to CRANE if not set)
LHAW_DEV_FIXED_SOLUTION=CRANE

# Optional dev user FID (defaults to 12345 if not set)
LHAW_DEV_USER_ID=12345

# Allow forced-state preview mode via URL params (devState, devInput)
LHAW_DEV_FORCE_STATE_ENABLED=false

# Wordnik API (Milestone 4.13 - Optional)
# Used for dictionary generation script: npm run generate-dictionaries:wordnik
# Get your free API key from: https://developer.wordnik.com/
# WORDNIK_API_KEY=your_wordnik_api_key_here

# ============================================================
# Smart Contract Configuration (Milestone 6.1)
# ============================================================

# JackpotManager Contract Address (DEPLOYED - Base Mainnet)
# This is the proxy address for the upgradeable contract
JACKPOT_MANAGER_ADDRESS=0xfcb0D07a5BB5B004A1580D5Ae903E33c4A79EdB5

# GuessLog Contract Address (Base Mainnet)
# Append-only Merkle commitments over each round's guess log, so the ordering
# that decides the winner and the top-10 cannot be rewritten after the fact.
# Unset = the /api/cron/guess-log-checkpoint job no-ops and nothing changes;
# set it to switch guess-log commitments on. Holds no funds.
GUESS_LOG_ADDRESS=

# Gas sponsorship for pack purchases (EIP-5792 + ERC-7677)
#
# PAYMASTER_SERVICE_URL is the upstream paymaster (Coinbase Developer Platform,
# Alchemy, Pimlico — any ERC-7677 endpoint). SERVER-SIDE ONLY: it usually
# carries an API key, and /api/paymaster proxies it so the key never reaches a
# browser. That proxy also enforces the policy that this can only ever pay for
# buyPacks on the pack sales contract — an unguarded paymaster URL is a public
# endpoint that spends money on whatever it is asked to.
#
# NEXT_PUBLIC_PAYMASTER_ENABLED turns the client path on. Unset or "false" means
# users pay their own gas, which is today's behaviour. Sponsorship is never
# load-bearing: a wallet without the capability, or a paymaster that refuses,
# still completes the purchase.
#
# The ERC-4337 bundling hazard is fixed (migration 0025): a purchase is keyed on
# (tx_hash, log_index) rather than tx_hash, so two players batched into one
# transaction are each credited for their own event. Apply 0025 before enabling.
PAYMASTER_SERVICE_URL=
NEXT_PUBLIC_PAYMASTER_ENABLED=false

# Prize Pool Wallet (letshaveaword.eth / letshaveaword.base.eth)
# Used to bootstrap rounds with seed ETH when necessary
PRIZE_POOL_WALLET=0xFd9716B26f3070Bc60AC409Aba13Dca2798771fB

# Operator Wallet
# Authorized to call restricted functions: resolving rounds, seeding jackpots, configuration
OPERATOR_WALLET=0xaee1ee60F8534CbFBbe856fEb9655D0c4ed35d38

# Creator Profit Wallet
# Receives the profit share from paid guess packs (20% of guess purchases)
CREATOR_PROFIT_WALLET=0x3Cee630075DC586D5BFdFA81F3a2d77980F0d223

# Deployer Private Key (NEVER commit this!)
# Used for contract deployment and upgrades
# DEPLOYER_PRIVATE_KEY=

# Base Sepolia RPC (for testnet deployment)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Sepolia JackpotManager Contract Address (for simulation testing)
# IMPORTANT: This MUST be different from JACKPOT_MANAGER_ADDRESS!
# If not set, falls back to JACKPOT_MANAGER_ADDRESS (wrong for production)
# Deploy a separate contract on Sepolia for testing
SEPOLIA_JACKPOT_MANAGER_ADDRESS=

# BaseScan API Key (for contract verification)
# Get from: https://basescan.org/apis
# BASESCAN_API_KEY=

# ============================================================
# Upstash Redis (Milestone 9.0)
# ============================================================
# Used for caching and rate limiting
# The app works without Redis (graceful degradation) but caching
# and rate limiting will be disabled.
#
# Supports TWO naming conventions (use either):
#
# Option 1: Vercel KV (if using Vercel's KV integration)
# KV_REST_API_URL=https://your-redis.upstash.io
# KV_REST_API_TOKEN=your_token_here
#
# Option 2: Upstash Direct (from https://console.upstash.com/)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# ============================================================
# Sentry Error Monitoring (Milestone 9.1)
# ============================================================
# Get your DSN from: https://sentry.io/
# Create a new Next.js project in Sentry to get these values.
# The app works without Sentry (errors logged to console only).

# Sentry DSN (required for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry org and project (required for source map uploads)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=lets-have-a-word

# Sentry auth token (for source map uploads during build)
# Get from: https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=sntrys_xxx

# ============================================================
# Vercel Cron (Milestone 9.1)
# ============================================================
# Secret for authenticating cron job requests.
# Vercel automatically sends this in the Authorization header.
# Generate a random string: openssl rand -hex 32

# CRON_SECRET=your_random_secret_here

# ============================================================
# Answer Encryption (Milestone 10)
# ============================================================
# AES-256-GCM encryption key for protecting the secret word.
# The answer is encrypted in the database so even a full DB breach
# won't reveal active round answers.
#
# CRITICAL: This key must be kept secure!
# - Store ONLY in Vercel environment variables (never in code/git)
# - Rotate if you suspect compromise
# - Different key per environment (dev vs prod)
#
# Generate with: openssl rand -hex 32
# Example: 4a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b
#
# WARNING: If you lose this key, you cannot decrypt existing answers!
# Keep a secure backup.

ANSWER_ENCRYPTION_KEY=

# ============================================================
# Superguess (Milestone 15)
# ============================================================
# Feature flag: Set to "true" to enable Superguess mechanic
# When disabled, all Superguess code paths are no-ops
NEXT_PUBLIC_SUPERGUESS_ENABLED=false

# Client-side operator wallet address (for Wagmi ERC-20 transfer target)
# Must match OPERATOR_WALLET — needs NEXT_PUBLIC_ prefix for client-side access
# NEXT_PUBLIC_OPERATOR_WALLET=0xaee1ee60F8534CbFBbe856fEb9655D0c4ed35d38

# walletlink.social API key (optional)
# Resolves a player's real X handle so the tweet crosspost can @mention the
# right account. Farcaster usernames and X handles are separate namespaces, so
# without this every player mention falls back to a plain name, which is safe
# but impersonal. Absent key = fallback, never an error.
WALLETLINK_API_KEY=
